NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres (Supabase). For migrations use port 5432 direct; for app pool use port 6543.
DATABASE_URL=postgresql://user:pass@host:6543/postgres
DATABASE_DIRECT_URL=postgresql://user:pass@host:5432/postgres

# Supabase JS client (server-side, service role). Used for simple CRUD only;
# transactions / locking / PostGIS still go through DATABASE_URL via pg.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Admin (service account)
FIREBASE_PROJECT_ID=cabsy-b3811
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@cabsy-b3811.iam.gserviceaccount.com
