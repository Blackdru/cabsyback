# JWT (RS256). Generate with:
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Then base64-encode each and put here (or use multiline with \n escapes).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS — comma-separated origins. Empty/missing in dev allows all; in prod rejects all.
# Example: CORS_ORIGINS=https://app.cabsy.io,https://admin.cabsy.io
CORS_ORIGINS=

# Google Maps Platform — required (Directions API). Get from Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Connection-pool + query-timeout tuning (optional; defaults shown).
PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=30000

# Dispatch tuning
DISPATCH_INITIAL_RADIUS_KM=5
DISPATCH_EXPANDED_RADIUS_KM=10
DISPATCH_EXPAND_AFTER_MS=30000

# SMS OTP API (Renflair SMS Gateway)
SMS_API_URL=https://sms.renflair.in/V1.php
SMS_API_KEY=576d026223582a390cd323bef4bad026
